DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/project_db
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
APP_NAME=Yee-Daa API
PROJECT_NAME=Yee-Daa API
API_V1_PREFIX=/api/v1
API_VERSION=0.1.0
DEBUG=true

STORAGE_PROVIDER=minio
STORAGE_BUCKET=omnicorp
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=omnicorp_user
STORAGE_SECRET_KEY=omnicorp_pw
STORAGE_ENDPOINT_URL=http://localhost:9000
STORAGE_PUBLIC_BASE_URL=http://localhost:9000/omnicorp
STORAGE_MAX_UPLOAD_BYTES=10485760
STORAGE_FORCE_PATH_STYLE=true
